# Optional read-only Vulnerability-Lookup used only for resolving foreign IDs
VL_URL=https://vulnerability.circl.lu

# Comma-separated import sources. Available: full-disclosure, bugtraq.
# This controls unattended `sync` and the defaults selected in the review UI.
VA_SOURCES=full-disclosure,bugtraq

# Optional LLM candidate comparison. Start with shadow mode. The model is never
# allowed to search outside the bounded Vulnerability-Lookup candidate set.
VA_LLM_MODE=off
VA_LLM_MODEL=
VA_LLM_API_URL=https://api.openai.com/v1/responses
OPENAI_API_KEY=

# VULNARCHIVE GNA identity
VA_GNA_ID=1988
VA_GNA_SHORT_NAME=VULNARCHIVE
VA_PUBLIC_BASE_URL=https://vuln.freearchive.org
# Stable UUID used in cveMetadata/providerMetadata. Set once and never rotate.
VA_GNA_ORG_UUID=4e2abfbf-4a2a-4b76-a4e0-d77c18ba156c

# Private analyst UI. Bind only to the server's RFC1918 interface.
VA_REVIEW_BIND=10.205.22.135
VA_REVIEW_PREFIX=/review
# Required HTTP Basic credentials. Generate a long random password.
VA_REVIEW_USERNAME=admin
VA_REVIEW_PASSWORD=replace-with-a-long-random-password
# Comma-separated CIDRs. Trust forwarding headers only from these proxy networks.
VA_REVIEW_ALLOWED_NETWORKS=10.205.0.0/16
VA_REVIEW_TRUSTED_PROXIES=10.205.0.0/16

# Both publication modes are enabled: context records and new advisories.
VA_PUBLISH_SIGHTINGS=true
VA_PUBLISH_CONTEXT_RECORDS=true

# Configurable evidence policy. This is a publication threshold, not validation.
VA_MIN_NEW_RECORD_SCORE=5
VA_MIN_CONTEXT_RECORD_SCORE=3
VA_MIN_BODY_CHARS=160
VA_REQUIRE_PRODUCT_FOR_NEW=true
VA_MAX_DESCRIPTION_CHARS=12000

# Unattended inferred references require one clear candidate. These are
# separate from the record evidence score and do not apply to explicit IDs.
VA_MIN_INFERRED_MATCH_CONFIDENCE=0.92
VA_MIN_INFERRED_MATCH_MARGIN=0.08

# Create a missing publication-year allocation range before reserving an ID.
VA_AUTO_CREATE_YEAR_RANGE=true
