[Unit]
Description=VULNARCHIVE private analyst review UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vulnarchive
Group=vulnarchive
WorkingDirectory=/opt/vulnarchive
EnvironmentFile=/etc/vulnarchive/vulnarchive.env
ExecStart=/opt/vulnarchive/.venv/bin/fd-sightings review --bind ${VA_REVIEW_BIND} --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vulnarchive/data

[Install]
WantedBy=multi-user.target
